{
	"name": "@anima/storyscript",
	"version": "0.1.0",
	"description": "Parser for StoryScript adventure game DSL",
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		}
	},
	"scripts": {
		"build": "tsc",
		"lint": "biome check .",
		"typecheck": "tsc --noEmit",
		"test": "vitest run --config vitest.config.ts",
		"parse": "tsx src/interpreter.ts"
	},
	"devDependencies": {
		"@types/node": "^22.0.0",
		"@biomejs/biome": "^2.3.9",
		"tsx": "^4.19.2",
		"typescript": "~5.7.2",
		"vitest": "^4.0.16"
	},
	"files": [
		"dist"
	],
	"keywords": [
		"parser",
		"dsl",
		"adventure-game",
		"storyscript"
	],
	"author": "Ajna Games",
	"license": "MIT"
}
