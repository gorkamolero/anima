{
	"$schema": "https://biomejs.dev/schemas/2.3.0/schema.json",
	"files": {
		"includes": [
			"**",
			"!**/dist/**",
			"!**/*.occluders.cache.json",
			"!tmp/**",
			"!**/public/generated/**",
			"!**/node_modules/**",
			"!packages/sprite-tools/output/**",
			"!packages/sprite-tools/outputs/**"
		]
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true
	}
}
