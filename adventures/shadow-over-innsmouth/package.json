{
	"name": "@anima/shadow-over-innsmouth",
	"description": "Shadow over Innsmouth adventure built with the Anima engine",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "vite --config vite/config.dev.mjs",
		"build": "vite build --config vite/config.prod.mjs",
		"calibrate:placement": "node scripts/calibrate-scene-placement.mjs",
		"review:exterior-sizing": "node scripts/review-exterior-sizing.mjs",
		"review:exterior-scale-candidates": "node scripts/review-exterior-scale-candidates.mjs",
		"review:scene-scale": "node scripts/review-scene-scale.mjs",
		"audit:animation-assets": "node scripts/audit-animation-assets.mjs",
		"audit:visual-reference": "node scripts/audit-visual-reference.mjs",
		"verify:scene": "node scripts/verify-playable-scene.mjs",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"playtest": "node scripts/playtest-journey.mjs",
		"verify:art": "node scripts/verify-art.mjs",
		"record": "node scripts/record-journey.mjs"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.9",
		"@tailwindcss/vite": "^4.1.18",
		"@types/react": "^19.2.7",
		"@types/react-dom": "^19.2.3",
		"tailwindcss": "^4.1.18",
		"typescript": "~5.7.2",
		"vite": "^6.3.1"
	},
	"dependencies": {
		"@anima/engine": "workspace:*",
		"@anima/storyscript": "workspace:*",
		"phaser": "^3.90.0",
		"react": "^19.2.3",
		"react-dom": "^19.2.3"
	}
}
